<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml — MindWalk application manifest

    Declares the app's identity, required permissions, and activity entry point.
    All network and location permissions are requested at relevant UI points:
    location at OnboardingScreen / PlanYourWalkScreen.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to call the Azure route-generation backend and Nominatim geocoder -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Used by ConnectivityManager to gate map/API calls when the device is offline -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Precise GPS coordinates for resolving the walk start location before route generation -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Fallback network-based location: faster to acquire, lower accuracy than GPS -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        usesCleartextTraffic="true": permits plain HTTP to the Azure backend and OSMDroid
        tile servers. Acceptable for development; for production, pin the backend certificate
        and remove this flag.

        enableOnBackInvokedCallback="true": opts into the Android 13+ predictive back gesture
        without the legacy OnBackPressedCallback API.
    -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MindWalk"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- OSMDroid uses the legacy Apache HTTP client on some older devices -->
        <uses-library android:name="org.apache.http.legacy" android:required="false"/>

        <!--
            MainActivity — single Activity hosting the Compose NavHost.
            All screens are Composable destinations; no additional activities are needed.
            The app follows the single-Activity architecture pattern.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MindWalk">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
